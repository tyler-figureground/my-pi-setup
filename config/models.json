{
  "providers": {
    "kimi-code-api": {
      "name": "Kimi Code (K3.1 direct)",
      "baseUrl": "https://api.kimi.ai/coding/v1",
      "api": "openai-completions",
      "apiKey": "!pi auth print-api-key --provider kimi-coding",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsStore": false,
        "supportsReasoningEffort": true
      },
      "models": [
        {
          "id": "k3.1-pro",
          "name": "Kimi K3.1 Pro",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 131072,
          "cost": { "input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 3 },
          "thinkingLevelMap": {
            "off": "low",
            "minimal": "low",
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "max",
            "max": "max"
          }
        },
        {
          "id": "k3.1-pro-highspeed",
          "name": "Kimi K3.1 Pro Highspeed",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 131072,
          "cost": { "input": 6, "output": 30, "cacheRead": 0.6, "cacheWrite": 6 },
          "thinkingLevelMap": {
            "off": "low",
            "minimal": "low",
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "max",
            "max": "max"
          }
        }
      ]
    }
  }
}
