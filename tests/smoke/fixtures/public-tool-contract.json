  {
    "name": "crawl",
    "parameters": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "description": "The starting URL to crawl."
        },
        "limit": {
          "type": "number",
          "description": "Maximum pages to crawl. Defaults to 20; maximum 100.",
          "minimum": 1,
          "maximum": 100
        },
        "maxDiscoveryDepth": {
          "type": "number",
          "description": "Maximum link-discovery depth from the starting URL.",
          "minimum": 0
        },
        "includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "URL pathname regex patterns to include."
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "URL pathname regex patterns to exclude."
        },
        "crawlEntireDomain": {
          "type": "boolean",
          "description": "Allow sibling and parent paths on the same domain."
        },
        "allowSubdomains": {
          "type": "boolean",
          "description": "Allow crawling subdomains."
        },
        "sitemap": {
          "type": "string",
          "enum": ["include", "skip", "only"]
        },
        "onlyMainContent": {
          "type": "boolean",
          "description": "Extract only each page's main content. Defaults to true."
        },
        "timeout": {
          "type": "number",
          "description": "Maximum crawl wait time in seconds. Defaults to 120.",
          "minimum": 1,
          "maximum": 600
        }
      }
    }
  },
  {
    "name": "fd",
    "parameters": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Regex matched against file names (or a glob when glob is true). Omit to list everything under path."
        },
        "path": {
          "type": "string",
          "description": "Directory to search. Defaults to the current working directory."
        },
        "type": {
          "type": "string",
          "enum": ["file", "directory", "symlink"],
          "description": "Only return entries of this type: file, directory, or symlink."
        },
        "extension": {
          "type": "string",
          "description": "Only return files with this extension, e.g. 'ts' or 'md'."
        },
        "glob": {
          "type": "boolean",
          "description": "Treat pattern as a glob (e.g. '*.test.ts') instead of a regex."
        },
        "hidden": {
          "type": "boolean",
          "description": "Include hidden files and directories. Defaults to false."
        },
        "max_depth": {
          "type": "integer",
          "description": "Maximum directory depth to descend (1-64).",
          "minimum": 1,
          "maximum": 64
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results (1-10000). Defaults to 1000.",
          "minimum": 1,
          "maximum": 10000
        }
      }
    }
  },
