  {
    "name": "monitor_change",
    "parameters": {
      "type": "object",
      "required": ["action", "id", "expectedRevision"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "replace", "pause", "resume", "stop", "delete"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scope": {
          "type": "string",
          "enum": ["session", "durable"]
        },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "required": ["kind", "terminalId"],
              "properties": {
                "kind": { "type": "string", "const": "terminal" },
                "terminalId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "framing": {
                  "type": "string",
                  "enum": ["line", "chunk"]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "root"],
              "properties": {
                "kind": { "type": "string", "const": "file" },
                "root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32768
                },
                "recursive": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "adapter", "intervalMs"],
              "properties": {
                "kind": { "type": "string", "const": "poll" },
                "adapter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "intervalMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "input": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {
                      "$defs": {
                        "JsonValue": {
                          "$id": "JsonValue",
                          "anyOf": [
                            { "type": "null" },
                            { "type": "boolean" },
                            { "type": "number" },
                            { "type": "string", "maxLength": 8192 },
                            {
                              "type": "array",
                              "items": { "$ref": "JsonValue" },
                              "maxItems": 64
                            },
                            {
                              "type": "object",
                              "patternProperties": {
                                "^.*$": { "$ref": "JsonValue" }
                              },
                              "maxProperties": 64
                            }
                          ]
                        }
                      },
                      "$ref": "JsonValue"
                    }
                  },
                  "maxProperties": 64
                },
                "credentialReference": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 235,
                  "pattern": "^credential:[A-Za-z0-9][A-Za-z0-9._-]{0,223}$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "url"],
              "properties": {
                "kind": { "type": "string", "const": "websocket" },
                "url": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 8192
                },
                "credentialReference": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 235,
                  "pattern": "^credential:[A-Za-z0-9][A-Za-z0-9._-]{0,223}$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "matcher": {
          "anyOf": [
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "type": "string", "const": "literal" },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "field", "equals"],
              "properties": {
                "kind": { "type": "string", "const": "field" },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "equals": {
                  "anyOf": [
                    { "type": "string", "maxLength": 4096 },
                    { "type": "number" },
                    { "type": "boolean" },
                    { "type": "null" }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "monitor_inspect",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "state": {
          "type": "string",
          "enum": ["active", "paused", "stopped", "blocked"]
        },
        "afterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "rg",
    "parameters": {
      "type": "object",
      "required": ["pattern"],
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Regex to search for (literal text when fixed_strings is true)."
        },
        "path": {
          "type": "string",
          "description": "File or directory to search. Defaults to the current working directory."
        },
        "glob": {
          "type": "string",
          "description": "Only search files matching this glob, e.g. '*.ts' or 'src/**'."
        },
        "file_type": {
          "type": "string",
          "description": "Only search files of this ripgrep type, e.g. 'ts', 'js', 'py', 'rust'."
        },
        "case_sensitive": {
          "type": "boolean",
          "description": "true forces case-sensitive matching, false forces case-insensitive. Defaults to smart-case."
        },
        "fixed_strings": {
          "type": "boolean",
          "description": "Treat pattern as a literal string instead of a regex."
        },
        "hidden": {
          "type": "boolean",
          "description": "Search hidden files and directories. Defaults to false."
        },
        "context": {
          "type": "integer",
          "description": "Lines of context to show around each match (0-20).",
          "minimum": 0,
          "maximum": 20
        },
        "limit": {
          "type": "integer",
          "description": "Maximum matches per file (1-1000). Defaults to 100.",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  },
  {
    "name": "schedule_change",
    "parameters": {
      "type": "object",
      "required": ["action", "id", "expectedRevision"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "replace", "pause", "resume", "run-now", "delete"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]{0,127}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scope": {
          "type": "string",
          "enum": ["session", "durable"]
        },
        "schedule": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["one-shot", "interval", "cron"]
            },
            "at": { "type": "string", "minLength": 20, "maxLength": 64 },
            "anchor": {
              "type": "string",
              "minLength": 20,
              "maxLength": 64
            },
            "everyMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "expression": {
              "type": "string",
              "minLength": 9,
              "maxLength": 256
            },
            "timeZone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "missedRunPolicy": {
          "type": "string",
          "enum": ["skip", "run-once"]
        },
        "profileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]{0,127}$"
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 262144 },
        "credentialReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^credential:[A-Za-z0-9][A-Za-z0-9._-]{0,223}$"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "policy": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000
            },
            "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
