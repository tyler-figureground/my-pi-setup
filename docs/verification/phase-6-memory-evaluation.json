      "categories": ["paraphrases", "known-lexical-limit"]
    },
    {
      "id": "identifier-ghsa",
      "writer": "alpha-main",
      "kind": "projectFact",
      "scope": "project",
      "content": "Track security advisory GHSA-3ppc-4f35-3m26 before dependency publication.",
