      "forbidden": []
    },
    {
      "id": "active-contradictions",
      "actor": "alpha-linked",
      "query": "Default formatter",
      "categories": ["stale", "contradictions", "linked-worktrees"],
      "relevant": ["formatter-stale", "formatter-current"],
      "forbidden": []
    },
    {
      "id": "expired-excluded",
      "actor": "alpha-main",
      "query": "Temporary migration codename Firefly",
      "categories": ["expiry"],
      "relevant": [],
      "forbidden": ["expired-migration"]
    },
    {
      "id": "linked-worktree-project-scope",
      "actor": "alpha-linked",
      "query": "Linked worktree shared setting Nimbus",
      "categories": ["linked-worktrees"],
      "relevant": ["linked-worktree-fact"],
      "forbidden": []
    },
    {
      "id": "alpha-project-isolation",
      "actor": "alpha-main",
      "query": "Quasar build channel",
      "categories": ["cross-project-isolation"],
      "relevant": ["alpha-isolation"],
      "forbidden": ["beta-isolation"]
    },
    {
      "id": "beta-project-isolation",
