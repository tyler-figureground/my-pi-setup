      "relevant": ["french-architecture"],
      "forbidden": []
    },
    {
      "id": "workspace-visible-to-owner",
      "actor": "alpha-workspace",
      "query": "Workspace codename Juniper",
      "within": ["workspace"],
      "categories": ["linked-worktrees", "workspace-isolation"],
      "relevant": ["workspace-juniper"],
      "forbidden": []
    },
    {
      "id": "workspace-hidden-from-linked-worktree",
      "actor": "alpha-linked",
      "query": "Workspace codename Juniper",
      "categories": ["linked-worktrees", "workspace-isolation"],
      "relevant": [],
      "forbidden": ["workspace-juniper"]
    }
  ],
  "automaticExtraction": {
    "currentExtractor": "absent",
    "currentPrediction": "no-writes",
    "automaticExtractionEnabled": false,
    "promotionPolicy": {
      "proposalStatus": "review",
      "promotionIngress": "direct-user"
    },
