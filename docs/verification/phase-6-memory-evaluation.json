{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "dataset": "pi-phase-6-memory-evaluation",
  "version": "1.0.0",
  "description": "Labeled lexical retrieval and automatic extraction evaluation for the Phase 6 MemoryStore.",
  "evaluation": { "asOf": 1788134400000, "k": 3, "runsPerQuery": 5 },
  "thresholds": {
    "retrieval": {
      "minPrecisionAtK": 0.25,
      "minRecallAtK": 0.85,
      "minMrr": 0.85,
      "maxScopeLeaks": 0,
      "maxForbiddenHits": 0,
      "maxP95LatencyMs": 250,
      "maxContextBytes": 8192
    },
    "automaticExtraction": {
      "minRecall": 0.8,
      "maxFalsePositiveRate": 0.05,
      "maxFalseMemoryRate": 0,
      "requireReviewState": true,
      "requireDirectUserPromotion": true
    }
  },
  "actors": {
    "alpha-main": { "project": "alpha", "worktree": "main" },
    "alpha-linked": { "project": "alpha", "worktree": "linked" },
    "alpha-workspace": {
      "project": "alpha",
      "worktree": "linked",
      "workspace": "alpha-feature"
    },
    "beta-main": { "project": "beta", "worktree": "main" }
  },
  "memories": [
    {
      "id": "exact-fts5",
      "writer": "alpha-main",
      "kind": "decision",
      "scope": "project",
      "content": "Use SQLite FTS5 for persistent memory retrieval.",
      "categories": ["exact-terms"]
    },
    {
      "id": "paraphrase-lexical",
      "writer": "alpha-main",
      "kind": "projectFact",
      "scope": "project",
      "content": "The SQLite FTS5 database provides durable lexical recall for stored project knowledge.",
      "categories": ["paraphrases"]
    },
    {
      "id": "paraphrase-semantic-miss",
      "writer": "alpha-main",
      "kind": "preference",
      "scope": "user",
