{
  "name": "tyler-pi-setup",
  "private": true,
  "pi": {
    "extensions": [
      "extensions/ask-user",
      "extensions/background-terminals",
      "extensions/copy-all",
      "extensions/file-search",
      "extensions/firecrawl-search",
      "extensions/git-info",
      "extensions/model-info",
      "extensions/platform",
      "extensions/spark-strict-tools",
      "extensions/subagents",
      "extensions/summaries",
      "extensions/ui-customization",
      "extensions/workflows"
    ],
    "skills": [
      "skills"
    ],
    "themes": [
      "themes"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/platform-node-shared": "4.0.0-beta.101",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@napi-rs/keyring": "1.3.0",
    "@parcel/watcher": "2.6.0",
    "acorn": "^8.17.0",
    "cron-parser": "5.10.0",
    "diff": "8.0.4",
    "effect": "4.0.0-beta.101",
    "firecrawl": "^4.30.0",
    "koffi": "3.2.1",
    "marked": "18.0.10",
    "minimatch": "10.2.5",
    "playwright-core": "1.62.1",
    "sanitize-html": "2.17.7",
    "typebox": "^1.3.6",
    "typescript-language-server": "6.0.0",
    "typescript-v5": "npm:typescript@5.9.3",
    "vscode-jsonrpc": "9.0.1",
    "vscode-languageserver-protocol": "3.18.2",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.101",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "2.16.1",
    "@types/ws": "8.18.1",
    "@modelcontextprotocol/server": "2.0.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "type": "module",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.101"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs install",
    "setup:doctor": "node scripts/setup.mjs doctor",
    "setup:update": "node scripts/setup.mjs update",
    "test:setup": "node --test tests/setup.test.mjs",
    "test:setup:smoke": "node tests/smoke/portable-setup.mjs",
    "check": "tsc --noEmit",
    "config:check": "node scripts/sync-config.mjs --check",
    "config:apply": "node scripts/sync-config.mjs --apply",
    "test:config": "node --test tests/sync-config.test.mjs",
    "format": "prettier --write \"extensions/**/*.{ts,cjs,json}\" \"tests/**/*.{ts,mjs,json}\" \"scripts/**/*.mjs\" \"config/*.json\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs,json}\" \"tests/**/*.{ts,mjs,json}\" \"scripts/**/*.mjs\" \"config/*.json\" \"*.json\"",
    "format:changed": "node scripts/format-changed.mjs",
    "install:extensions": "node scripts/install-extension-dependencies.mjs",
    "install:extensions:ci": "node scripts/install-extension-dependencies.mjs --ci",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-test-suite.mjs unit",
    "test:integration": "node scripts/run-test-suite.mjs integration",
    "test:live": "npm --prefix extensions/subagents run test:live",
    "test:smoke": "node tests/smoke/pi-smoke.mjs",
    "verify": "npm run check && npm run format:check && npm test && npm run test:smoke && npm run test:live"
  }
}
